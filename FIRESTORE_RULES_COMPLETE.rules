rules_version = '2';

// ============================================================
//  Item RDC — règles Firestore complètes (sécurisées)
//  Firebase > Firestore Database > Règles > remplacer TOUT, puis « Publier ».
//  PRÉREQUIS : l'administrateur est connecté dans l'app admin ET son UID existe
//  dans la collection « admins » (voir GUIDE_SECURITE_ET_CHAT.md).
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Administrateur : document admins/{uid} créé à la main dans la console.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Premium actif : date d'expiration dans le profil de l'utilisateur.
    function isPremium() {
      return signedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.premiumExpiryTime > request.time;
    }

    // Suspension du chat (until = null : définitive).
    function chatBanned() {
      let p = /databases/$(database)/documents/chat_bans/$(request.auth.uid);
      return exists(p) && (get(p).data.until == null || get(p).data.until > request.time);
    }

    // Interrupteurs du chat (settings/chat : generalEnabled, helpEnabled, dmEnabled).
    function chatFlag(name) {
      return get(/databases/$(database)/documents/settings/chat).data[name] == true;
    }

    // Pseudo enregistré de l'utilisateur connecté.
    function myPseudo() {
      return get(/databases/$(database)/documents/chat_profiles/$(request.auth.uid)).data.pseudo;
    }

    // Lien de fichier/image : uniquement le stockage Supabase de l'application.
    function okUrl(u) {
      return u is string && u.size() < 500 &&
        (u == '' || u.matches('https://[a-z0-9]+\\.supabase\\.co/storage/v1/object/public/(media|publications)/.*'));
    }

    // ---------- Administrateurs ----------
    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // ---------- Profils utilisateurs ----------
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // Inscription : l'essai Premium ne peut pas dépasser 2 jours.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'firstName', 'lastName', 'email', 'phone', 'profileImage',
          'createdAt', 'premiumBoughtTime', 'premiumExpiryTime',
          'isOnline', 'lastSeen', 'fcmToken', 'fcmUpdatedAt'])
        && request.resource.data.premiumExpiryTime <= request.time + duration.value(2, 'd');

      // Un utilisateur ne peut JAMAIS modifier son Premium.
      allow update: if (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName', 'lastName', 'phone', 'profileImage',
            'isOnline', 'lastSeen', 'fcmToken', 'fcmUpdatedAt']))
        || isAdmin();

      allow delete: if isAdmin();
    }

    // ---------- Contenu (lecture : connectés ; écriture : admin) ----------
    match /GENERAL_HOME/{id}   { allow read: if signedIn();                allow write: if isAdmin(); }
    match /GENERAL_VIDEOS/{id} { allow read: if signedIn();                allow write: if isAdmin(); }
    match /PREMIUM_HOME/{id}   { allow read: if isPremium() || isAdmin();  allow write: if isAdmin(); }
    match /PREMIUM_VIDEOS/{id} { allow read: if isPremium() || isAdmin();  allow write: if isAdmin(); }

    match /categories/{document=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /settings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- Publications (ouvrages et documents des utilisateurs) ----------
    match /publications/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.keys().hasOnly([
          'uid', 'kind', 'ownerName', 'title', 'type', 'academicYear',
          'categoryId', 'categoryTitle', 'universityId', 'universityName',
          'space', 'folderId', 'folderTitle', 'subFolderTitle',
          'details', 'fileUrl', 'coverUrl', 'status', 'reason', 'createdAt']);
      allow read: if signedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // ---------- Chat : profils et pseudos ----------
    match /chat_profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pseudo', 'pseudoLower', 'createdAt'])
        && request.resource.data.pseudo.matches('^[A-Za-z0-9_.-]{3,20}$')
        && request.resource.data.pseudoLower == request.resource.data.pseudo.lower()
        && request.resource.data.createdAt == request.time;
      allow update: if false;          // le pseudo ne change pas (l'admin peut le réinitialiser)
      allow delete: if isAdmin();
    }

    match /chat_pseudos/{p} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/chat_profiles/$(request.auth.uid)).data.pseudoLower == p;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Chat : suspensions ----------
    match /chat_bans/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------- Chat : groupe général ----------
    match /chat_rooms/{room}/messages/{m} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 100;
      allow create: if signedIn() && room == 'general'
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'type', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'text'
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && myPseudo() == request.resource.data.pseudo
        && chatFlag('generalEnabled')
        && !chatBanned();
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---------- Chat : messages privés ----------
    match /chat_dms/{dmId} {
      allow get: if signedIn() && (resource == null || request.auth.uid in resource.data.members);
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && dmId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.keys().hasOnly([
          'members', 'names', 'labels', 'lastMessage', 'lastAt',
          'lastSender', 'reads', 'blockedBy', 'createdAt'])
        && request.resource.data.lastSender == request.auth.uid
        && request.resource.data.blockedBy.size() == 0
        && request.resource.data.lastMessage.size() <= 120
        && chatFlag('dmEnabled')
        && !chatBanned();

      allow update: if signedIn()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastAt', 'lastSender', 'names', 'reads', 'blockedBy'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSender'])
            || request.resource.data.lastSender == request.auth.uid)
        // On ne peut modifier que SON propre blocage.
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['blockedBy'])
            || (request.resource.data.blockedBy.hasAll(resource.data.blockedBy.removeAll([request.auth.uid]))
                && request.resource.data.blockedBy.removeAll(resource.data.blockedBy).hasOnly([request.auth.uid])));

      allow delete: if false;

      match /messages/{m} {
        allow get: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_dms/$(dmId)).data.members;
        allow list: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chat_dms/$(dmId)).data.members
          && request.query.limit <= 100;
        allow create: if signedIn()
          && request.auth.uid in getAfter(/databases/$(database)/documents/chat_dms/$(dmId)).data.members
          && request.resource.data.keys().hasOnly([
            'uid', 'pseudo', 'text', 'type', 'fileUrl', 'fileName', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text', 'file', 'image']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.type != 'text' || request.resource.data.text.size() > 0)
          && (request.resource.data.type == 'text' || request.resource.data.fileUrl != '')
          && okUrl(request.resource.data.fileUrl)
          && request.resource.data.fileName is string
          && request.resource.data.fileName.size() <= 120
          && myPseudo() == request.resource.data.pseudo
          && getAfter(/databases/$(database)/documents/chat_dms/$(dmId)).data.blockedBy.size() == 0
          && chatFlag('dmEnabled')
          && !chatBanned();
        allow update, delete: if false;
      }
    }

    // ---------- Entraide (questions avec image + réponses) ----------
    match /help_posts/{id} {
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 60;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'imageUrl', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt == request.time
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && okUrl(request.resource.data.imageUrl)
        && myPseudo() == request.resource.data.pseudo
        && chatFlag('helpEnabled')
        && !chatBanned();

      // L'auteur peut seulement marquer « résolu » / rouvrir.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['open', 'solved'];

      allow delete: if isAdmin();

      match /replies/{r} {
        allow get: if signedIn();
        allow list: if signedIn() && request.query.limit <= 100;
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['uid', 'pseudo', 'text', 'imageUrl', 'createdAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && okUrl(request.resource.data.imageUrl)
          && myPseudo() == request.resource.data.pseudo
          && chatFlag('helpEnabled')
          && !chatBanned();
        allow update: if false;
        allow delete: if isAdmin();
      }
    }

    // ---------- Chat : signalements ----------
    match /chat_reports/{id} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.keys().hasOnly([
          'kind', 'messageId', 'postId', 'replyId', 'messageText', 'messageUid',
          'messagePseudo', 'reason', 'reporterUid', 'status', 'createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // Tout le reste est interdit.
  }
}
